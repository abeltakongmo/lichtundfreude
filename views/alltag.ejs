                                    { value: "holzkirchen", text: "Holzkirchen" },
                                    { value: "rosenheim", text: "Rosenheim" }
                                ],
                                schwaben: [
                                    { value: "memmingen", text: "Memmingen" },
                                    { value: "kempten", text: "Kempten" },
                                    { value: "augsburg", text: "Augsburg" }
                                ],
                                niederbayern: [
                                    { value: "landshut", text: "Landshut" },
                                    { value: "passau", text: "Passau" }
                                ],
                                oberpfalz: [
                                    { value: "regensburg", text: "Regensburg" },
                                    { value: "amberg", text: "Amberg" }
                                ]
                            },

                            badenwuerttemberg: {
                                stuttgart: [
                                    { value: "stuttgart", text: "Stuttgart" },
                                    { value: "esslingen", text: "Esslingen" }
                                ],
                                karlsruhe: [
                                    { value: "karlsruhe", text: "Karlsruhe" },
                                    { value: "rastatt", text: "Rastatt" }
                                ]
                            }
                        };

                        function updateRegions() {
                            const state = document.getElementById("hero-state-select").value;
                            const regionSelect = document.getElementById("hero-region-select");
                            const citySelect = document.getElementById("hero-location-select");

                            regionSelect.innerHTML =
                                '<option value="">Region wählen</option>';
                            citySelect.innerHTML =
                                '<option value="">Stadt wählen</option>';

                            if (!state || !locations[state]) return;

                            Object.keys(locations[state]).forEach(region => {
                                const option = document.createElement("option");
                                option.value = region;
                                option.textContent = region
                                    .replace(/([A-Z])/g, ' $1')
                                    .replace(/^./, c => c.toUpperCase());
                                regionSelect.appendChild(option);
                            });
                        }

                        function updateCities() {
                            const state = document.getElementById("hero-state-select").value;
                            const region = document.getElementById("hero-region-select").value;
                            const citySelect = document.getElementById("hero-location-select");

                            citySelect.innerHTML =
                                '<option value="">Stadt wählen</option>';

                            if (!locations[state]?.[region]) return;

                            locations[state][region].forEach(city => {
                                const option = document.createElement("option");
                                option.value = city.value;
                                option.textContent = city.text;
                                citySelect.appendChild(option);
                            });
                        }
