                    <script>
                        function detectLocation() {
                            const result = document.getElementById("geo-result");

                            if (!navigator.geolocation) {
                                result.classList.remove("hidden");
                                result.innerHTML =
                                    '<i class="fa-solid fa-circle-exclamation mr-1"></i> Geolokalisierung wird von Ihrem Browser nicht unterstützt.';
                                return;
                            }

                            navigator.geolocation.getCurrentPosition(
                                async (position) => {
                                    const lat = position.coords.latitude;
                                    const lon = position.coords.longitude;

                                    result.classList.remove("hidden");
                                    result.innerHTML =
                                        `<i class="fa-solid fa-spinner fa-spin mr-1"></i> Standort wird ermittelt...`;

                                    try {
                                        const response = await fetch(
                                            `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lon}&format=json`
                                        );

                                        const data = await response.json();

                                        const city =
                                            data.address.city ||
                                            data.address.town ||
                                            data.address.village ||
                                            "Unbekannt";

                                        const state =
                                            data.address.state || "Unbekannt";

                                        result.innerHTML = `
                                            <i class="fa-solid fa-check-circle mr-1"></i>
                                            Standort erkannt:
                                            <strong>${city}</strong>,
                                            ${state}
                                        `;

                                        document.getElementById(
                                            "selected-city-name"
                                        ).textContent = city;

                                    } catch (error) {
                                        result.innerHTML =
                                            '<i class="fa-solid fa-triangle-exclamation mr-1"></i> Standort konnte nicht ermittelt werden.';
                                    }
                                },
                                () => {
                                    result.classList.remove("hidden");
                                    result.innerHTML =
                                        '<i class="fa-solid fa-circle-xmark mr-1"></i> Zugriff auf Standort wurde verweigert.';
                                }
                            );
                        }
                    </script>
