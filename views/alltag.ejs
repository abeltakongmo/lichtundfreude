    <!-- JavaScript for Interactivity -->
    <script>
        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Interactive Location Selector in Hero
        function updateLocationFromHero() {
            const select = document.getElementById('hero-location-select');
            const selectedText = select.options[select.selectedIndex].text.split('&')[0].trim();
            
            const badge = document.getElementById('current-location-badge');
            const feedback = document.getElementById('hero-location-feedback');
            const cityNameSpan = document.getElementById('selected-city-name');

            badge.textContent = selectedText;
            cityNameSpan.textContent = selectedText;
            feedback.classList.remove('hidden');

            // Also update contact form dropdown
            const contactSelect = document.getElementById('contact-city-select');
            for(let i=0; i<contactSelect.options.length; i++) {
                if(contactSelect.options[i].text.toLowerCase().includes(selectedText.toLowerCase())) {
                    contactSelect.selectedIndex = i;
                    break;
                }
            }
        }

        // Quick City Button Click
        function setCity(cityName) {
            const badge = document.getElementById('current-location-badge');
            badge.textContent = cityName;

            // Scroll smoothly to contact or show notification
            const contactSection = document.getElementById('kontakt');
            contactSection.scrollIntoView({ behavior: 'smooth' });

            const contactSelect = document.getElementById('contact-city-select');
            for(let i=0; i<contactSelect.options.length; i++) {
                if(contactSelect.options[i].text.toLowerCase().includes(cityName.toLowerCase())) {
                    contactSelect.selectedIndex = i;
                    break;
                }
            }
        }

        function selectCity(cityName) {
            setCity(cityName);
        }

        // Handle Contact Form Submission
        function handleContactSubmit(event) {
            event.preventDefault();
            const successBox = document.getElementById('success-box');
            successBox.classList.remove('hidden');
            successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            event.target.reset();
        }
    </script>
