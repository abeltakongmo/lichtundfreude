<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Neue Anfrage für eine kostenlose Beratung</title>
  </head>
  <body style="margin:0;padding:24px;background:#f8fafc;font-family:Arial,sans-serif;color:#1e293b;line-height:1.6">
    <main style="max-width:620px;margin:0 auto;padding:32px;background:#fff;border:1px solid #e2e8f0;border-radius:16px">
      <p style="margin:0 0 8px;color:#0369a1;font-size:13px;font-weight:bold;text-transform:uppercase;letter-spacing:1px">Licht und Freude</p>
      <h1 style="margin:0 0 16px;font-size:24px">Neue Anfrage für eine kostenlose Beratung</h1>
      <p style="margin:0 0 24px">Über das Kontaktformular wurde eine neue Beratungsanfrage gesendet.</p>
      <table style="width:100%;border-collapse:collapse">
        <tr><th align="left" style="padding:10px 0;border-bottom:1px solid #e2e8f0">Name</th><td style="padding:10px 0;border-bottom:1px solid #e2e8f0"><%= consultation.name %></td></tr>
        <tr><th align="left" style="padding:10px 0;border-bottom:1px solid #e2e8f0">Telefon</th><td style="padding:10px 0;border-bottom:1px solid #e2e8f0"><%= consultation.phone %></td></tr>
        <tr><th align="left" style="padding:10px 0;border-bottom:1px solid #e2e8f0">E-Mail</th><td style="padding:10px 0;border-bottom:1px solid #e2e8f0"><%= consultation.email || "Nicht angegeben" %></td></tr>
        <tr><th align="left" style="padding:10px 0;border-bottom:1px solid #e2e8f0">Gewünschter Standort</th><td style="padding:10px 0;border-bottom:1px solid #e2e8f0"><%= consultation.location %></td></tr>
        <tr><th align="left" style="padding:10px 0;border-bottom:1px solid #e2e8f0">Pflegegrad</th><td style="padding:10px 0;border-bottom:1px solid #e2e8f0"><%= consultation.careLevel %></td></tr>
      </table>
      <h2 style="margin:24px 0 8px;font-size:16px">Nachricht oder Wünsche</h2>
      <p style="margin:0;white-space:pre-wrap"><%= consultation.message || "Keine Nachricht angegeben" %></p>
    </main>
  </body>
</html>
